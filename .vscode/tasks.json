{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "g++: 编译当前文件",
      "type": "process",
      "command": "C:/msys64/ucrt64/bin/g++.exe",
      "args": [
        "-std=c++17",
        "-Wall",
        "-Wextra",
        "-g",
        "-o",
        "${workspaceFolder}/build/${fileBasenameNoExtension}.exe",
        "${file}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "detail": "编译当前打开的 .cpp，输出到 build/（不运行）。Ctrl+Shift+B 默认执行这个；F5 调试前也用它。type=process：直接调 g++，不经 PowerShell，避免与终端 profile 的参数冲突"
    },
    {
      "label": "g++: 编译并运行当前文件",
      "type": "process",
      "command": "${workspaceFolder}/build/${fileBasenameNoExtension}.exe",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "dependsOn": [
        "g++: 编译当前文件"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "detail": "先编译当前文件，再运行生成的 exe（用 Run Task 调用）"
    },
    {
      "label": "clean: 删除 build 目录",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-NoLogo",
        "-Command",
        "Remove-Item -LiteralPath '${workspaceFolder}\\build' -Recurse -Force -ErrorAction SilentlyContinue"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "detail": "清掉编译产物（-NoProfile 绕开终端 profile）"
    },
    {
      "label": "g++: 编译整个 src 目录",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-NoLogo",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\\\build.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "detail": "调用 build.ps1：把 src 下所有 .cpp 编成 build/kv_cache.exe",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "运行: build/kv_cache.exe",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-NoLogo",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\\\build.ps1",
        "-Run"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "detail": "调用 build.ps1 -Run：编译整个 src 后立即运行 build/kv_cache.exe，并打印退出码"
    }
  ]
}
